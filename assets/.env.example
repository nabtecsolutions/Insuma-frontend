# Copiá este archivo como `assets/.env` (mismo directorio) y completá los valores.
# Sin `assets/.env` la app NO compila: el pubspec.yaml lo declara como asset.
# `assets/.env` está en .gitignore: no se sube al repo.

# Conexión a Supabase. Pedile los dos valores al equipo de desarrollo.
# Sin estos dos valores la app arranca pero no se puede iniciar sesión.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Estrategia de persistencia: hibrido (por defecto) | supabase | local
APP_PERSISTENCIA=hibrido

# true = base de datos local en memoria (se borra al cerrar la app)
APP_USE_MEMORY_DB=false

# Bypass para revisiones de tiendas. Dejar en false.
APP_STORE_REVIEW=false
