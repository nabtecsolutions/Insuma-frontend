<?xml version="1.0" encoding="utf-8"?>
<!-- HU-112: hardening de la cuenta local. Excluye TODO de las transferencias de
     backup y de dispositivo-a-dispositivo (Android 12+, API 31). Con
     allowBackup="false" el backup en la nube ya está deshabilitado; esto cubre
     además la transferencia device-to-device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
